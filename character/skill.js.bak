                trigger: {
                    player: "phaseDrawEnd",
                },
                forced: true,
                filter: function (event, player) {
                    return game.countPlayer(function (current) {
                        return current.getShownCards().length > 0;
                    }) > 0;
                },
                content: function () {
                    for (var i of game.players) {
